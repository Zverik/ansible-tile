[Unit]
Description=Every Door Plugin Repository
After=syslog.target

[Service]
Type=simple
Restart=on-failure
User=zverik
Group=zverik
WorkingDirectory=/opt/src/edpr
ExecStart=/opt/src/edpr/bin/gunicorn -w 4 -b 0.0.0.0:{{ edpr_port }} 'app:create_app()'
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/var/log/apache2/{{ domain }}/py-stdout.log
StandardError=append:/var/log/apache2/{{ domain }}/py-stderr.log

[Install]
WantedBy=multi-user.target
